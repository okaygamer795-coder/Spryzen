<Window x:Class="SideLoadr.SetupWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SideLoadr Setup" Height="540" Width="620"
        Background="#1E1E1E" Foreground="#E0E0E0"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9E9E9E"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background" Value="#3E3E42"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="18">
        <TextBlock Text="Let's get you set up" FontSize="20" FontWeight="Bold" Foreground="White"/>
        <TextBlock Text="Work top to bottom — green dot means good. This wizard never changes anything, it only checks." Style="{StaticResource Hint}" Margin="0,2,0,10"/>

        <Border Background="#252526" CornerRadius="8" Padding="10" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock Name="Step1Dot" Text="●" FontSize="18" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button Content="Check" Style="{StaticResource Btn}" DockPanel.Dock="Right" VerticalAlignment="Center" Click="Step1_Click"/>
                <StackPanel>
                    <TextBlock Text="1 · Apple drivers" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Name="Step1Text" Text="Needed so the PC sees your iPhone (Apple Devices or iTunes)." Style="{StaticResource Hint}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Background="#252526" CornerRadius="8" Padding="10" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock Name="Step2Dot" Text="●" FontSize="18" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Content="Open tools folder" Style="{StaticResource Btn}" Click="OpenTools_Click"/>
                    <Button Content="Check" Style="{StaticResource Btn}" Click="Step2_Click"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="2 · Helper tools" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Name="Step2Text" Text="ideviceinstaller + zsign go in the tools folder next to the app." Style="{StaticResource Hint}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Background="#252526" CornerRadius="8" Padding="10" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock Name="Step3Dot" Text="●" FontSize="18" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button Content="Detect" Style="{StaticResource Btn}" DockPanel.Dock="Right" VerticalAlignment="Center" Click="Step3_Click"/>
                <StackPanel>
                    <TextBlock Text="3 · iPhone connected" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Name="Step3Text" Text="USB cable in, Trust tapped on the phone." Style="{StaticResource Hint}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Background="#252526" CornerRadius="8" Padding="10" Margin="0,0,0,10">
            <DockPanel>
                <TextBlock Name="Step4Dot" Text="●" FontSize="18" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button Content="Test" Style="{StaticResource Btn}" DockPanel.Dock="Right" VerticalAlignment="Center" Click="Step4_Click"/>
                <StackPanel>
                    <TextBlock Text="4 · Signing helper reachable" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Name="Step4Text" Text="Checks the pre-filled anisette address answers." Style="{StaticResource Hint}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Run all checks" Style="{StaticResource Btn}" Click="RunAll_Click"/>
            <Button Content="Beginner guide" Style="{StaticResource Btn}" Click="Guide_Click"/>
        </StackPanel>
        <DockPanel>
            <Button Content="Close" Style="{StaticResource Btn}" Width="90" DockPanel.Dock="Right" Click="Close_Click"/>
            <CheckBox Name="ShowOnStartupBox" Content="Show this wizard on startup" Foreground="#9E9E9E" VerticalAlignment="Center" IsChecked="True"/>
        </DockPanel>
    </StackPanel>
</Window>
